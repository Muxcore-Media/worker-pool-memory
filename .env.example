# MuxCore worker-pool-memory — Environment Variables

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=worker-pool-memory

# HTTP task store (loopback by default)
# WORKER_POOL_HTTP_ADDR=127.0.0.1:9300
# WORKER_POOL_API_TOKEN=
# WORKER_POOL_QUEUE_CAPACITY=10000

# Discouraged: advertises worker.pool on the mesh (collides with core)
# WORKER_POOL_ADVERTISE_CAPABILITY=0

# MVP stack (_mvp/run-host.sh)
# MVP_ENABLE_WORKER_POOL=0
