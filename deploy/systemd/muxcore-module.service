[Unit]
Description=MuxCore worker-pool-memory (deprecated HTTP task store)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
Environment=MUXCORE_MODULE_ID=worker-pool-memory
Environment=WORKER_POOL_HTTP_ADDR=127.0.0.1:9300
EnvironmentFile=-/etc/muxcore/worker-pool-memory.env
ExecStart=/usr/local/bin/worker-pool-memory
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
